# VITE_GEMINI_API_KEY: Required for client-side Gemini AI & Live Voice calls (including static Vercel deployments).
# Set this in your Vercel Project Environment Variables (or .env locally).
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback variable name used during local Vite build if VITE_GEMINI_API_KEY is unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
